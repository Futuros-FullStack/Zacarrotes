<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="492.0" prefWidth="1055.0" styleClass="root" stylesheets="@style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">

    <!-- TOP: Barra de navegacion -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15" styleClass="top-bar" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="16" left="20" right="20" top="16" />
            </padding>

            <!-- Logo / nombre -->
            <VBox spacing="0">
                <Label styleClass="logo-title" text="Zacarrotes" />
                <Label styleClass="logo-subtitle" text="Caja 1" />
            </VBox>

            <!-- Buscador -->
            <TextField fx:id="txtBuscar" prefWidth="220" promptText="Buscar producto o marca" styleClass="search-field" />

            <!-- Espaciador -->
            <Region HBox.hgrow="ALWAYS" />

            <!-- Menu -->
            <Button fx:id="btnVenta" styleClass="menu-button" text="🛒 Venta" />
            <Button fx:id="btnProductos" styleClass="menu-button" text="📦 Productos" />
            <Button fx:id="btnClientes" styleClass="menu-button-active" text="👤 Clientes" />
            <Button fx:id="btnProveedores" styleClass="menu-button" text="🚚 Proveedores" />

            <!-- Usuario -->
            <HBox alignment="CENTER" spacing="8" />
        </HBox>
    </top>

    <!-- CENTER: Formulario + Tabla -->
    <center>
        <HBox spacing="20" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20" left="20" right="20" top="20" />
            </padding>

            <!-- Panel izquierdo: formulario -->
            <VBox prefWidth="220" spacing="12" styleClass="card">
                <padding>
                    <Insets bottom="20" left="20" right="20" top="20" />
                </padding>

                <Label styleClass="card-title" text="Datos del cliente" />

                <Label styleClass="field-label" text="Nombre" />
                <TextField fx:id="txtNombre" styleClass="text-input" text="Carmen Ruiz" />

                <Label styleClass="hint-text" text="Es el único dato que guarda la tabla cliente" wrapText="true" />

                <Region VBox.vgrow="ALWAYS" />

                <Button fx:id="btnGuardar" maxWidth="Infinity" styleClass="button-primary" text="💾 Guardar" />

                <HBox spacing="8">
                    <Button fx:id="btnNuevo" maxWidth="Infinity" styleClass="button-secondary" text="+ Nuevo" HBox.hgrow="ALWAYS" />
                    <Button fx:id="btnLimpiar" maxWidth="Infinity" styleClass="button-neutral" text="🖉 Limpiar" HBox.hgrow="ALWAYS" />
                </HBox>

                <Button fx:id="btnEliminar" maxWidth="Infinity" styleClass="button-danger" text="🗑 Eliminar seleccionado" />
            </VBox>

            <!-- Panel derecho: tabla -->
            <VBox spacing="15" styleClass="card" HBox.hgrow="ALWAYS">
                <padding>
                    <Insets bottom="20" left="20" right="20" top="20" />
                </padding>

                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label styleClass="card-title" text="Clientes registrados" />
                    <Label fx:id="lblContadorClientes" styleClass="badge" text="6" />
                </HBox>

                <TableView fx:id="tablaClientes" styleClass="dark-table" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="45" text="ID" />
                        <TableColumn fx:id="colNombre" prefWidth="160" text="NOMBRE" />
                        <TableColumn fx:id="colCompras" prefWidth="80" text="COMPRAS" />
                        <TableColumn fx:id="colUltima" prefWidth="90" text="ÚLTIMA" />
                        <TableColumn fx:id="colAcumulado" prefWidth="100" text="ACUMULADO" />
                    </columns>
                </TableView>
            </VBox>
        </HBox>
    </center>

    <!-- BOTTOM: Barra de estado -->
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="status-bar" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="10" left="20" right="20" top="10" />
            </padding>
            <Label fx:id="lblEstado" styleClass="status-ok" text="✓ Listo" />
            <Region HBox.hgrow="ALWAYS" />
            <Label styleClass="status-hint" text="compras y acumulado se calculan desde venta" />
        </HBox>
    </bottom>

</BorderPane>
