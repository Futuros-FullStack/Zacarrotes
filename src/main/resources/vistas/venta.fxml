<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<!--
    Vista de Venta - Zacarrotes

    Rejilla de tarjetas de producto a la izquierda y ticket a la derecha.

    boxTarjetas va VACIO a proposito: el diseno de la tarjeta vive en
    comunes/tarjeta-producto.fxml y el controlador la carga una vez por
    producto del catalogo. Asi un producto nuevo aparece aqui solo, sin
    tocar este archivo.

    El ticket es una tabla REAL (tblTicket) sobre detalleventa.
    Modelo esperado: DetalleVenta con nombreproducto, cantidad y subtotal
    (subtotal = precio * cantidad; venta.total es la suma de los subtotales).
-->

<BorderPane fx:id="pnlRaiz" prefHeight="720.0" prefWidth="1150.0" stylesheets="@../estilos/general.css, @../estilos/venta.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="michelle.zacarrotes.controlador.VentaController">

    <top>
        <fx:include fx:id="navbar" source="comunes/navbar.fxml" />
    </top>

    <center>
        <VBox fx:id="pnlContenido">

            <HBox fx:id="boxCuerpo" VBox.vgrow="ALWAYS">

                <!-- ============ Rejilla de productos ============ -->
                <VBox fx:id="pnlCatalogo" spacing="12.0" HBox.hgrow="ALWAYS">
                    <padding>
                        <Insets bottom="18.0" left="18.0" right="18.0" top="16.0" />
                    </padding>

                    <HBox fx:id="boxTitulo" alignment="BOTTOM_LEFT" spacing="10.0">
                        <Label fx:id="lblTitulo" styleClass="card-title" text="Todos los productos" />
                        <Label fx:id="lblConteo" styleClass="conteo-articulos" text="0 artículos" />
                    </HBox>

                    <ScrollPane fx:id="scrProductos" fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS">
                        <!-- Lo llena el controlador con tarjeta-producto.fxml -->
                        <FlowPane fx:id="boxTarjetas" hgap="12.0" prefWrapLength="720.0" vgap="12.0" />
                    </ScrollPane>
                </VBox>

                <!-- ============ Ticket ============ -->
                <VBox fx:id="pnlTicket" minWidth="290.0" prefWidth="290.0" spacing="14.0" styleClass="ticket-panel">
                    <padding>
                        <Insets bottom="18.0" left="18.0" right="18.0" top="16.0" />
                    </padding>

                    <HBox fx:id="boxTituloTicket" alignment="CENTER_LEFT" spacing="10.0">
                        <Label fx:id="lblTituloTicket" styleClass="card-title" text="Ticket" />
                        <Label fx:id="lblFolio" styleClass="badge-ticket" />
                    </HBox>

                    <ComboBox fx:id="cboCliente" maxWidth="Infinity" promptText="Público general" />

                    <!--
                        Renglones del ticket: tabla REAL sobre detalleventa.
                        El estado vacio del diseno ahora es el placeholder del
                        TableView, asi que se ve solo mientras no hay partidas.
                    -->
                    <VBox fx:id="pnlTablaTicket" styleClass="table-card" VBox.vgrow="ALWAYS">
                        <TableView fx:id="tblTicket" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colTicketProducto" minWidth="85.59997557401657" prefWidth="96.79992674589157" style="-fx-font-weight: bold;" text="PRODUCTO">
                                    <cellValueFactory>
                                        <PropertyValueFactory property="nombreproducto" />
                                    </cellValueFactory>
                                </TableColumn>

                                <TableColumn fx:id="colTicketCantidad" maxWidth="80.0" minWidth="40.0" prefWidth="73.5999755859375" style="-fx-alignment: CENTER-RIGHT;" text="CANT.">
                                    <cellValueFactory>
                                        <PropertyValueFactory property="cantidad" />
                                    </cellValueFactory>
                                </TableColumn>

                                <TableColumn fx:id="colTicketSubtotal" minWidth="65.0" prefWidth="80.7999267578125" style="-fx-alignment: CENTER-RIGHT;" text="SUBTOTAL">
                                    <cellValueFactory>
                                        <PropertyValueFactory property="subtotal" />
                                    </cellValueFactory>
                                </TableColumn>
                            </columns>

                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>

                            <placeholder>
                                <VBox fx:id="boxTicketVacio" alignment="CENTER" spacing="10.0">
                                    <SVGPath content="M1.5 2.5h2l2 8h8 M4.5 4.5h11l-1.2 4.5h-8.6 M6.2 13.4a1 1 0 1 0 0.01 0 Z M12.2 13.4a1 1 0 1 0 0.01 0 Z" styleClass="icon, icon-carrito-vacio" />
                                    <Region prefHeight="14.0" />
                                    <Label styleClass="ticket-vacio" text="El ticket está vacío." />
                                    <Label styleClass="ticket-vacio" text="Toca un producto para agregarlo." />
                                </VBox>
                            </placeholder>
                        </TableView>
                    </VBox>

                    <!-- Totales -->
                    <HBox fx:id="boxArticulos" alignment="CENTER_LEFT">
                        <Label styleClass="ticket-etiqueta" text="Artículos" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblArticulos" styleClass="ticket-valor" text="0" />
                    </HBox>

                    <!-- venta.total -->
                    <HBox fx:id="boxTotal" alignment="CENTER_LEFT">
                        <Label styleClass="ticket-total-etiqueta" text="TOTAL" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblTotal" styleClass="ticket-total" text="\$0.00" />
                    </HBox>

                    <Button fx:id="btnCobrar" contentDisplay="LEFT" graphicTextGap="8.0" maxWidth="Infinity" styleClass="btn-cobrar" text="Cobrar">
                        <graphic>
                            <SVGPath content="M1.5 2.5h2l2 8h8 M4.5 4.5h11l-1.2 4.5h-8.6 M6.2 13.4a1 1 0 1 0 0.01 0 Z M12.2 13.4a1 1 0 1 0 0.01 0 Z" styleClass="icon, icon-white" />
                        </graphic>
                    </Button>

                    <Button fx:id="btnCancelar" maxWidth="Infinity" styleClass="btn, btn-ghost" text="Cancelar venta" />
                </VBox>
            </HBox>
        </VBox>
    </center>
</BorderPane>
