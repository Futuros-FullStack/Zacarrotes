<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<!--
    Vista de Proveedores - Conectada al Controlador.
    Las filas estáticas serán reemplazadas dinámicamente por el VBox boxFilas.
    Vista de Proveedores - Zacarrotes
    Tabla REAL (TableView) sobre proveedor(idproveedor, nombreproveedor,
    direccion, telefono).

    Modelo esperado: Proveedor con esas cuatro propiedades (los
    PropertyValueFactory leen sus getters).
-->

<BorderPane fx:id="pnlRaiz" prefHeight="720.0" prefWidth="1150.0" stylesheets="@../../estilos/general.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.zacarrotes.ProveedoresController">
<BorderPane fx:id="pnlRaiz" prefHeight="720.0" prefWidth="1150.0" stylesheets="@../../estilos/general.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="michelle.zacarrotes.controlador.ProveedorController">

    <top>
        <fx:include fx:id="navbar" source="../comunes/navbar.fxml" />
    </top>

    <center>
        <HBox fx:id="pnlContenido" spacing="0.0">

            <!-- Formulario -->
            <VBox fx:id="pnlFormulario" minWidth="310.0" prefWidth="310.0" spacing="14.0" styleClass="form-card">
                <padding>
                    <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
                </padding>

                <Label fx:id="lblTituloFormulario" styleClass="card-title" text="Datos del proveedor" />

                <VBox fx:id="boxNombre" spacing="6.0">
                    <Label fx:id="lblNombre" styleClass="field-label" text="Nombre" />
                    <TextField fx:id="txtNombre" promptText="Grupo Bimbo" />
                </VBox>

                <VBox fx:id="boxDireccion" spacing="6.0">
                    <Label fx:id="lblDireccion" styleClass="field-label" text="Dirección" />
                    <TextField fx:id="txtDireccion" promptText="Calle Pino Suárez 45, Centro" />
                </VBox>

                <VBox fx:id="boxTelefono" spacing="6.0">
                    <Label fx:id="lblTelefono" styleClass="field-label" text="Teléfono" />
                    <TextField fx:id="txtTelefono" promptText="2299113045" />
                    <Label fx:id="lblTelefonoHint" styleClass="form-hint" text="10 dígitos, sin guiones ni espacios" />
                </VBox>

                <Region VBox.vgrow="ALWAYS" />

                <Button fx:id="btnGuardar" contentDisplay="LEFT" graphicTextGap="8.0" maxWidth="Infinity" onAction="#guardar" styleClass="btn, btn-primary" text="Guardar">
                <Button fx:id="btnGuardar" onAction="#guardarProveedor" contentDisplay="LEFT" graphicTextGap="8.0" maxWidth="Infinity" styleClass="btn, btn-primary" text="Guardar">
                    <graphic>
                        <SVGPath content="M2.5 2.5h8l3 3v8h-11z M5 2.5v4h5v-4 M5 13.5v-4h6v4" styleClass="icon, icon-white" />
                    </graphic>
                </Button>

                <Button fx:id="btnEliminar" contentDisplay="LEFT" graphicTextGap="8.0" maxWidth="Infinity" onAction="#eliminar" styleClass="btn, btn-danger" text="Eliminar seleccionado">
                <Button fx:id="btnEliminar" onAction="#eliminarProveedor" contentDisplay="LEFT" graphicTextGap="8.0" maxWidth="Infinity" styleClass="btn, btn-danger" text="Eliminar seleccionado">
                    <graphic>
                        <SVGPath content="M2.5 4h11 M6 4V2.2h4V4 M4 4l0.8 10h6.4L12 4 M6.6 6.5v5 M9.4 6.5v5" styleClass="icon, icon-danger" />
                    </graphic>
                </Button>
            </VBox>

            <!-- Listado -->
            <VBox fx:id="pnlListado" spacing="12.0" styleClass="catalog-card" HBox.hgrow="ALWAYS">
                <padding>
                    <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
                </padding>

                <HBox fx:id="boxTitulo" alignment="CENTER_LEFT" spacing="10.0">
                    <Label fx:id="lblTitulo" styleClass="card-title" text="Proveedores registrados" />
                    <Label fx:id="lblTotalProveedores" styleClass="badge-count" text="0" />
                </HBox>

                <!-- El marco redondeado lo pone el VBox .table-card; el TableView va transparente encima -->
                <VBox fx:id="pnlTabla" styleClass="table-card" VBox.vgrow="ALWAYS">
                    <TableView fx:id="tblProveedores" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colIdProveedor" maxWidth="120.0" minWidth="70.0" prefWidth="90.0" text="IDPROVEEDOR">
                                <cellValueFactory>
                                    <PropertyValueFactory property="id" />
                                </cellValueFactory>
                            </TableColumn>

                            <TableColumn fx:id="colNombreProveedor" minWidth="180.0" prefWidth="220.0" style="-fx-font-weight: bold;" text="NOMBRE">
                                <cellValueFactory>
                                    <PropertyValueFactory property="nombre" />
                                </cellValueFactory>
                            </TableColumn>

                            <TableColumn fx:id="colDireccion" minWidth="220.0" prefWidth="340.0" text="DIRECCIÓN">
                                <cellValueFactory>
                                    <PropertyValueFactory property="direccion" />
                                </cellValueFactory>
                            </TableColumn>

                            <TableColumn fx:id="colTelefono" minWidth="110.0" prefWidth="140.0" style="-fx-alignment: CENTER-RIGHT;" text="TELÉFONO">
                                <cellValueFactory>
                                    <PropertyValueFactory property="telefono" />
                                </cellValueFactory>
                            </TableColumn>
                        </columns>

                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>

                        <placeholder>
                            <Label fx:id="lblTablaVacia" styleClass="tabla-vacia" text="No hay proveedores registrados" />
                        </placeholder>
                    </TableView>
                </VBox>
            </VBox>
        </HBox>
    </center>

    <bottom>
        <HBox fx:id="pnlBarraEstado" alignment="CENTER_LEFT" spacing="8.0" styleClass="statusbar" />
    </bottom>
</BorderPane>